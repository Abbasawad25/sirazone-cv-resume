##################################################
#
# DO NOT EDIT THIS FILE
#
# Create a new .htaccess file in your htdocs
# directory (or example.com/htdocs/ directory)
# to add your own rules or override these rules.
#
##################################################

# Prevent script execution in uploads (Apache)
# Deny access to PHP files and disable handlers
<FilesMatch "\.(php|php5|phtml|phar)$">
  Require all denied
</FilesMatch>

# Disable script handlers for common extensions (older Apache syntax)
RemoveHandler .php .php5 .phtml .phar

# Prevent directory listing
Options -Indexes
DirectoryIndex index.php index.html index.htm index2.html app/index.php

ErrorDocument 403 https://sirazone.kesug.com/404.php
ErrorDocument 404 https://sirazone.kesug.com/404.php
ErrorDocument 500 https://sirazone.kesug.com/500.php
ErrorDocument 505 https://sirazone.kesug.com/505.php